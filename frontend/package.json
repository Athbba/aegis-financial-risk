{
  "name": "aegis-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.json",
    "format:check": "prettier --check src e2e *.ts *.json"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.16",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
