# Copy to .env, replace with a strong local password. Never commit .env.
DATABASE_PASSWORD=replace-with-a-unique-local-password
# Set true when serving behind HTTPS. Local HTTP development requires false.
COOKIE_SECURE=false
# Optional Actuator metrics: BCrypt hash, never a shared application-user password.
# AEGIS_OPERATIONS_PASSWORD_HASH=
# Least privilege override (generate independent credentials outside Git):
# AEGIS_RUNTIME_USER=aegis_runtime
# AEGIS_RUNTIME_PASSWORD=
# Separate short-lived --migrate-only process:
# MIGRATION_DATABASE_URL=jdbc:postgresql://localhost:5432/aegis
# MIGRATION_USERNAME=
# MIGRATION_PASSWORD=
