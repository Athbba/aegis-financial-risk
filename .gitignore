.npmrc

# Build outputs, dependencies, caches and browser-test artifacts.
backend/target/
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
frontend/*.tsbuildinfo
node_modules/
.cache/
__pycache__/
