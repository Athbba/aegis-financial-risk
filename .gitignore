# Local database files, backups and scratch data. Flyway SQL remains tracked.
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.dump
*.backup
pgdata/
postgres-data/
.local/

# Editor and operating-system metadata.
.idea/
.vscode/
*.swp
.DS_Store

# Public certificate serial scratch is generated only in private rehearsal directories.
*.srl
